# ===========================================
# Billo - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# --- Supabase ---
# Found in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=eyJ...
# Service role key (SECRET — server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google OAuth (optional — enables "Continuer avec Google" on the login page) ---
# 1. Go to Supabase Dashboard > Authentication > Providers > Google
# 2. Enable Google and paste your Client ID + Client Secret from Google Cloud Console
# 3. In Google Cloud Console, add your Supabase callback URL as an authorised redirect URI:
#    https://<your-project>.supabase.co/auth/v1/callback
# 4. In Supabase Dashboard > Authentication > URL Configuration, add:
#    http://localhost:3000/auth/callback   (dev)
#    https://your-domain.com/auth/callback (prod)
# No extra env vars are needed here — the credentials live in Supabase, not in .env.

# --- AI Providers ---
# At least one of these is required for voice invoice generation.
# If neither is set, users must supply their own key in Settings.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# --- Flutterwave (désactivé sur le site — ne pas renseigner sauf réactivation) ---
# Si tu réactives : dashboard Flutterwave, webhook /api/webhooks/flutterwave, CSP next.config.js
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-hash

# --- FedaPay (Afrique / XOF) ---
# Mode test : utiliser les clés sk_sandbox_... et pk_sandbox_...
# Mode live : utiliser les clés sk_live_... et pk_live_...
# Dashboard : https://app.fedapay.com
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- Lemon Squeezy (International / EUR & USD) ---
# Mode test : créer une API key en "Test mode" dans le dashboard
# Mode live : créer une API key en "Live mode"
# Dashboard : https://app.lemonsqueezy.com
# Les Variant IDs se trouvent dans Products > Variants du dashboard
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs par plan et devise (Products > Variants dans le dashboard)
LEMONSQUEEZY_VARIANT_EARLY_BIRD_EUR=
LEMONSQUEEZY_VARIANT_EARLY_BIRD_USD=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY_EUR=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY_USD=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL_EUR=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL_USD=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY_EUR=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY_USD=
LEMONSQUEEZY_VARIANT_BUSINESS_ANNUAL_EUR=
LEMONSQUEEZY_VARIANT_BUSINESS_ANNUAL_USD=

# --- Admin ---
# The email address of the admin user (must match a registered Supabase user).
# This user gets access to /admin and the admin API.
ADMIN_EMAIL=admin@example.com
# Required to store OpenAI/Gemini keys from the admin UI (32 bytes, base64).
# openssl rand -base64 32
# ADMIN_SECRETS_ENCRYPTION_KEY=zxa25Zyn089X4AUb6ivFuOu9aGzkFqghy7cLs7ht3Po=

# --- App ---
# Full public URL of the app (used for payment redirect URLs and password reset).
# In production, set to your deployed domain (e.g. https://billo.regiskiki.me).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase Auth → URL Configuration → add Redirect URL:
# http://localhost:3000/auth/callback (and your production URL + /auth/callback)
